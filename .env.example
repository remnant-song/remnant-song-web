# 环境变量配置（示例）
# @Author: trae+deepseek-v4-pro
# @Date: 2026-08-10
# @Desc: 复制此文件为 .env 并填入真实值
#   所有以 VITE_ 开头的变量可通过 import.meta.env.VITE_XXX 访问

# R2 存储外链基础 URL
VITE_R2_BASE_URL=

# 应用标题
VITE_APP_TITLE=Remnant Song

# API 基础路径（预留）
VITE_API_BASE_URL=

# 是否开启调试模式
VITE_DEBUG=false

# ============================================================
# GitHub 博客同步配置
# ============================================================

# 文章数据源：local（本地）或 github（远程仓库）
VITE_POST_SOURCE=local

# GitHub 仓库信息
VITE_GITHUB_OWNER=
VITE_GITHUB_REPO=
VITE_GITHUB_BRANCH=main

# GitHub Personal Access Token（可选，提升 API 限速）
VITE_GITHUB_TOKEN=

# ============================================================
# Gitee 镜像仓库配置（国内降级方案）
# GitHub 不可用时自动切换，无需用户干预
# ============================================================

# Gitee 仓库所有者
VITE_GITEE_OWNER=remnant-song

# Gitee 仓库名
VITE_GITEE_REPO=REMNANT-SONG_Devlop_Obsidian

# Gitee 分支名
VITE_GITEE_BRANCH=main

# Gitee 私人令牌（可选，提升 API 限速）
VITE_GITEE_TOKEN=