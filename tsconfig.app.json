{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],

    /*
     * @Author: trae+claude
     * @Date: 2026-06-24
     * @Desc: 开启 TypeScript 严格模式，确保类型安全
     */
    "strict": true,

    /*
     * @Author: trae+claude
     * @Date: 2026-06-24
     * @Desc: 配置路径映射，与 vite.config.ts 中的 @ 别名保持一致
     */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.json"]
}
