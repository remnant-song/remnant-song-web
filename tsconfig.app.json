{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],

    /*
     * @Author: trae+deepseek-v4-pro
     * @Date: 2026-06-24
     * @Desc: 开启 TypeScript 严格模式，确保类型安全
     */
    "strict": true,

    /*
     * @Author: trae+deepseek-v4-pro
     * @Date: 2026-08-12
     * @Desc: 忽略 TS 6.0 废弃选项警告（@vue/tsconfig 继承的 baseUrl 在 TS 6.0 已废弃）
     */
    "ignoreDeprecations": "6.0",

    /*
     * @Author: trae+deepseek-v4-pro
     * @Date: 2026-06-24
     * @Modify: trae+deepseek-v4-pro, 2026-08-12,
     *   移除 baseUrl（TS 6.0 已废弃），paths 独立解析相对于 tsconfig 所在目录
     * @Desc: 配置路径映射，与 vite.config.ts 中的 @ 别名保持一致
     */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/**/*.json"]
}
