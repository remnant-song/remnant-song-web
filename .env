# 环境变量配置
# @Author: trae+claude
# @Date: 2026-06-24
# @Desc: 项目环境变量，以 VITE_ 前缀暴露给客户端代码
#   所有以 VITE_ 开头的变量可通过 import.meta.env.VITE_XXX 访问

# R2 存储外链基础 URL（默认留空，部署时按需填入）
VITE_R2_BASE_URL=

# 应用标题
VITE_APP_TITLE=Remnant Song

# API 基础路径（预留）
VITE_API_BASE_URL=

# 是否开启调试模式（dev 环境默认 true，prod 默认 false）
VITE_DEBUG=false
